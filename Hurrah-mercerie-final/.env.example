# Copie ce fichier en .env.local et remplis les valeurs.
# Sur Vercel : Settings > Environment Variables (mêmes noms).

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# Adresse publique du site (pour Google et les aperçus WhatsApp)
NEXT_PUBLIC_SITE_URL=https://hurrahmercerie.com

# Contact
NEXT_PUBLIC_WHATSAPP_NUMBER=22901XXXXXXXX
NEXT_PUBLIC_PHONE_DISPLAY=+229 01 XX XX XX XX
NEXT_PUBLIC_ADDRESS=Cotonou, Bénin

# Numéros marchands Mobile Money (laisser vide si pas encore ouvert)
NEXT_PUBLIC_MOMO_NAME=Hurrah Mercerie
NEXT_PUBLIC_MOMO_MTN=
NEXT_PUBLIC_MOMO_MOOV=
NEXT_PUBLIC_MOMO_CELTIIS=

# Traduction automatique dans l'admin (secret : PAS de NEXT_PUBLIC_)
DEEPL_API_KEY=

# Clé SECRÈTE Supabase (Project Settings > API > service_role). Serveur uniquement,
# sert à écrire le journal des connexions. Ne jamais la préfixer NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Pages légales (laisser vide = ligne non affichée)
NEXT_PUBLIC_LEGAL_NAME=Hurrah Mercerie
NEXT_PUBLIC_LEGAL_RCCM=
NEXT_PUBLIC_LEGAL_IFU=
NEXT_PUBLIC_LEGAL_OWNER=
NEXT_PUBLIC_CONTACT_EMAIL=
# Délais affichés sur la page « Livraison et retours »
NEXT_PUBLIC_DELIVERY_DAYS=24 à 72 h
NEXT_PUBLIC_DELIVERY_DAYS_EN=24 to 72 hours
NEXT_PUBLIC_RETURN_DAYS=7
