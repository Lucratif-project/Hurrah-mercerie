diff --git a/lib/i18n/localized.ts b/lib/i18n/localized.ts
new file mode 100644
index 0000000..1dd5d60
--- /dev/null
+++ b/lib/i18n/localized.ts
@@ -0,0 +1,26 @@
+import type { Locale } from "./config";
+
+/**
+ * Renvoie la version traduite d'un champ Supabase (ex. `name_en`, `name_fon`)
+ * quand elle existe ; sinon la version française. Un produit n'apparaît donc
+ * jamais vide.
+ *
+ *   tr(product, "name", locale)
+ */
+export function tr(
+  row: Record<string, unknown> | null | undefined,
+  field: string,
+  locale: Locale
+): string {
+  if (!row) return "";
+
+  if (locale !== "fr") {
+    const translated = row[`${field}_${locale}`];
+    if (typeof translated === "string" && translated.trim() !== "") {
+      return translated;
+    }
+  }
+
+  const fr = row[field];
+  return typeof fr === "string" ? fr : "";
+}
diff --git a/lib/i18n/server.ts b/lib/i18n/server.ts
new file mode 100644
index 0000000..b97ac0d
--- /dev/null
+++ b/lib/i18n/server.ts
@@ -0,0 +1,15 @@
+import { cookies } from "next/headers";
+import { dictionaries } from "./dictionaries";
+import { LOCALE_COOKIE, normalizeLocale, type Locale } from "./config";
+
+/** Langue choisie par le visiteur (cookie), français par défaut. */
+export async function getLocale(): Promise<Locale> {
+  const store = await cookies();
+  return normalizeLocale(store.get(LOCALE_COOKIE)?.value);
+}
+
+/** À utiliser dans les composants serveur : const { t, locale } = await getI18n(); */
+export async function getI18n() {
+  const locale = await getLocale();
+  return { locale, t: dictionaries[locale] };
+}
